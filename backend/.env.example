# Copy this file to .env and adjust. .env must never be committed.
# Stage 4 runs without Docker, so these are read from your machine.

PORT=3000
NODE_ENV=development

# 'memory' = data disappears on restart (Stage 2)
# 'mysql'  = data is stored in the todo_db database (Stage 3+)
DB_DRIVER=memory

# Only used when DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=todo_db
DB_POOL_SIZE=5